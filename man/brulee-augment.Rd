 augment(reg_fit, ames_test)

 # Without the outcome column, there are no residuals:
 augment(reg_fit, ames_test[, c("Longitude", "Latitude")])

 # Predictions from a specific epoch:
 augment(reg_fit, ames_test, epoch = 10)

