Package: brulee
Title: High-Level Modeling Functions with 'torch'
Version: 1.2.0.9000
Authors@R: c(
    person("Max", "Kuhn", , "max@posit.co", role = c("aut", "cre"),
           comment = c(ORCID = "0000-0003-2402-136X")),
    person("Daniel", "Falbel", , "daniel@posit.co", role = "aut"),
